{
  "name": "@poynt/on-poynt-db",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.ts",
      "default": "./index.ts"
    },
    "./schema": {
      "types": "./schema/index.ts",
      "default": "./schema/index.ts"
    }
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run migrate.ts",
